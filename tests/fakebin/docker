#!/usr/bin/env bash
# fake docker for container-watchdog tests. State lives in $FAKE_DIR/<container>/{status,finished,portcfg,ports}
S="${FAKE_DIR:?}"
if [ -f "$S/DOCKER_DOWN" ]; then
  echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2; exit 1
fi
case "$1" in
  container)   # docker container inspect -f FMT NAME
    name="${@: -1}"
    [ -d "$S/$name" ] || { echo "Error response from daemon: No such container: $name" >&2; exit 1; }
    echo "$(cat "$S/$name/status")|$(cat "$S/$name/finished")|$(cat "$S/$name/portcfg")" ;;
  port)
    cat "$S/$2/ports" 2>/dev/null ;;
  start)
    echo "start $2" >> "$S/actions.log"
    [ -f "$S/START_FAILS" ] && { echo "Error response from daemon: cannot start $2" >&2; exit 1; }
    echo running > "$S/$2/status"; echo "$2" ;;
  image)    # docker image inspect -f FMT IMG
    cat "$S/image_id" 2>/dev/null || echo "sha256:aaa" ;;
  compose)
    case " $* " in
      *" config --images "*) echo "ghcr.io/example/app:latest"; exit 0 ;;
      *" pull "*|*" pull")
        echo "compose $* (cwd=$PWD)" >> "$S/actions.log"
        [ -f "$S/PULL_FAILS" ] && { echo "Error response from daemon: Get https://registry: dial tcp: i/o timeout" >&2; exit 1; }
        [ -f "$S/PULL_NEWIMAGE" ] && echo "sha256:bbb" > "$S/image_id"
        echo "Pulled"; exit 0 ;;
    esac
    echo "compose $* (cwd=$PWD)" >> "$S/actions.log"
    [ -f "$S/START_FAILS" ] && { echo "compose up failed" >&2; exit 1; }
    for d in "$S"/*/; do n=$(basename "$d"); echo running > "$d/status"; [ -s "$d/portcfg" ] && [ "$(cat "$d/portcfg")" != 0 ] && echo "8080/tcp -> 0.0.0.0:8080" > "$d/ports"; done
    echo "done" ;;
  *) echo "fake docker: unsupported $*" >&2; exit 1 ;;
esac
